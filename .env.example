# ==============================================================================
# Nepal Disaster Relief Transit & Pass Coordination System
# Environment Configuration Template
# ==============================================================================

# Database Connection (Turso / LibSQL or local SQLite file)
TURSO_URL="file:local.db"
TURSO_AUTH_TOKEN=""

# Cryptographic Keys (Required for signing & HMAC pass token generation)
JWT_SECRET="replace-with-a-secure-random-64-character-secret-in-production"
HMAC_SECRET="replace-with-a-secure-hmac-sha256-key-in-production"

# Initial Seeding Passwords (Override when executing scripts/seed.ts in production)
ADMIN_PASSWORD="YourComplexAdminPasswordHere!"
DISPATCHER_PASSWORD="YourComplexDispatcherPasswordHere!"
CHECKPOINT_PASSWORD="YourComplexOfficerPasswordHere!"
MOHA_PASSWORD="YourComplexMohaPasswordHere!"
