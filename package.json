{
  "name": "relief-vehicle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --filter \"*\" dev",
    "dev:api": "bun --filter \"@relief/api\" dev",
    "dev:web": "bun --filter \"@relief/web\" dev",
    "build": "bun --filter \"*\" build",
    "build:api": "bun --filter \"@relief/api\" build",
    "build:web": "bun --filter \"@relief/web\" build",
    "db:migrate": "bun run ./scripts/migrate.ts",
    "db:seed": "bun run ./scripts/seed.ts",
    "test": "bun run ./scripts/test-e2e.ts",
    "deploy:web": "bash ./scripts/deploy.sh web",
    "deploy:api": "bash ./scripts/deploy.sh api",
    "deploy": "bun run deploy:api && bun run deply:web"
  },
  "devDependencies": {
    "@libsql/client": "0.17.4",
    "@tanstack/intent": "0.3.7",
    "@tanstack/router-core": "1.171.27",
    "jose": "6.2.10",
    "typescript": "^5.8.2",
    "wrangler": "^4.104.0"
  }
}
